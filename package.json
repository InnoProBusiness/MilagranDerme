{
  "name": "milagran-plataforma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:migrate": "node-pg-migrate -d DIRECT_URL -m migrations up",
    "db:types": "kysely-codegen --out-file src/lib/db-types.ts",
    "usuario:criar": "node scripts/criar-usuario.mjs"
  },
  "dependencies": {
    "kysely": "^0.28.0",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "kysely-codegen": "^0.18.0",
    "node-pg-migrate": "^7.9.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
