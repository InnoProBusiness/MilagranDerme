# Resend API key (resend.com) — never commit the real value
RESEND_API_KEY=

# Sender address, must be a verified domain/sender in Resend.
# Use the .com.br domain — milagranoficial.com (without .br) does not exist.
# Verify milagranoficial.com.br in Resend and publish its SPF/DKIM records
# before the first send, otherwise every email is rejected or lands in spam.
# e.g. "Milagran <candidaturas@milagranoficial.com.br>"
EMAIL_FROM=

# Destination address that receives new candidatura notifications
EMAIL_TO=

# "true" to also send a confirmation email to the candidate
ENVIAR_CONFIRMACAO=false

# --- Banco de dados ---
# Local: docker compose up -d
#
# Producao NAO usa este arquivo: a stack do Swarm injeta as variaveis no
# container (ver DEPLOY.md). La a conexao vai direto ao Postgres do swarm,
# sem pooler — a aplicacao e um processo de vida longa com pool proprio de
# 5 conexoes (src/lib/db.ts) contra um servidor com max_connections=500.
# Pooler externo so faria sentido em runtime serverless, onde cada request
# pode abrir conexao nova; nao e o caso deste deploy.
DATABASE_URL=postgres://milagran:milagran@localhost:55432/milagran

# O script "db:migrate" aponta node-pg-migrate explicitamente para esta
# variavel (via "-d DIRECT_URL", nome da env var, nunca a URL embutida no
# comando). Nao simplifique o script para o default (DATABASE_URL): mantendo
# as duas separadas, o dia em que um pooler entrar na frente da aplicacao
# nao arrasta o DDL junto — pooler em modo transaction nao sustenta o
# advisory lock de sessao que o node-pg-migrate segura entre statements.
# Hoje as duas apontam para o mesmo servidor, aqui e em producao.
DIRECT_URL=postgres://milagran:milagran@localhost:55432/milagran

# --- Mercado Pago ---
# As tres variaveis abaixo saem do mesmo lugar:
# https://www.mercadopago.com.br/developers/panel/app -> sua aplicacao.
#
# O PREFIXO DO ACCESS TOKEN DECIDE O AMBIENTE, nao existe flag separada:
#   TEST-...     sandbox, nenhum dinheiro real se move
#   APP_USR-...  producao, cobra de verdade
# E por isso que a integracao inteira pode ser construida e testada antes de
# o CNPJ passar no KYC: quando a conta abrir, so o valor destas variaveis muda.
#
# ACCESS TOKEN E SEGREDO DE SERVIDOR. Ele autoriza criar cobranca e consultar
# qualquer pagamento da conta — nunca vai para o navegador, nunca para o
# repositorio.
MERCADOPAGO_ACCESS_TOKEN=

# Chave PUBLICA. Esta sim vai para o navegador: e ela que o SDK usa para
# tokenizar o cartao antes de qualquer dado chegar a este servidor.
MERCADOPAGO_PUBLIC_KEY=

# Segredo da assinatura do webhook. No painel: Webhooks -> Configurar
# notificacoes -> "Assinatura secreta". Sem ele a rota /api/webhooks/mercadopago
# RECUSA tudo com 503 — de proposito: sem assinatura nao ha como distinguir
# notificacao legitima de POST forjado, e um forjado marcaria pedido como pago.
MERCADOPAGO_WEBHOOK_SECRET=

# URL publica da aplicacao. Monta a notification_url enviada ao Mercado Pago e
# o link do e-mail de confirmacao. Precisa ser HTTPS e alcancavel de fora — o
# proprio Mercado Pago recusa http:// e localhost, entao em desenvolvimento
# isto so funciona atras de um tunel.
APP_URL=https://milagranoficial.com.br

# Segredo para assinar o cookie de atribuicao (HMAC).
# Minimo 32 caracteres — a aplicacao recusa iniciar o fluxo de atribuicao
# com um segredo mais curto. O comando abaixo gera 64 (32 bytes em hex).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATRIBUICAO_SECRET=
