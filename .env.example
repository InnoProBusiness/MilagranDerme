# Resend API key (resend.com) — never commit the real value
RESEND_API_KEY=

# Sender address, must be a verified domain/sender in Resend
# e.g. "Milagran <candidaturas@milagranoficial.com>"
EMAIL_FROM=

# Destination address that receives new candidatura notifications
EMAIL_TO=

# "true" to also send a confirmation email to the candidate
ENVIAR_CONFIRMACAO=false
