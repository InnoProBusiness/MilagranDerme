# Environment variables — never commit real secrets
.env
.env.local
.env.*.local

# Vercel
.vercel

# Dependencies (in case a package.json is added later)
node_modules

# OS/editor cruft
.DS_Store
Thumbs.db

# Next.js build output
.next/

# Auto-generated by Next.js / TypeScript — regenerated on every dev/build/typecheck
next-env.d.ts
*.tsbuildinfo

# Scratch space for the build process — never commit
.superpowers/

# Local Docker Compose override (e.g. remapping the db port if something
# else already occupies it on a given machine). Never commit — the
# canonical port for the team lives only in docker-compose.yml.
docker-compose.override.yml
